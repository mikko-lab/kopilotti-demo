{
  "name": "kopilotti-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:static": "npx --yes serve . -l 8090",
    "generate:inventory": "node scripts/generate-inventory.js",
    "check:backend": "node --check server.js && node --check lib/analysis-contract.js && node --check lib/runtime-config.js",
    "test": "vitest run",
    "test:backend": "vitest run tests/backend"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.51.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
