# Master switch for the paid analysis path. Defaults to false (safe): the
# service starts and serves /health + vehicle lookup with no key at all.
# Only flip to true, with a real ANTHROPIC_API_KEY set below, once you have
# deliberately decided to accept the model-cost/abuse exposure.
ANALYSIS_ENABLED=false
# Required only when ANALYSIS_ENABLED=true. Leave blank otherwise - do not
# put a real key here.
ANTHROPIC_API_KEY=
ALLOWED_ORIGIN=https://mikko-lab.github.io
ANTHROPIC_TIMEOUT_MS=15000
ANALYZE_RATE_LIMIT_MAX=10
PORT=3001
